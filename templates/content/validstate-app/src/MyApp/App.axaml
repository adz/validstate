<Application
    x:Class="MyApp.UI.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    RequestedThemeVariant="Dark">
    <Application.Styles>
        <shadui:ShadTheme />
    </Application.Styles>
</Application>
